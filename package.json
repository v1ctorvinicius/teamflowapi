{
  "name": "teamflowapi",
  "version": "0.1.0",
  "description": "TeamFlow — sports e-commerce API",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "echo 'Skipping TypeScript build'",
    "start": "tsx ./src/server.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "db:migrate": "psql $DATABASE_URL -f migrations/001_initial_schema.sql"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "4.1.5",
    "pino-pretty": "^13.0.0",
    "tsx": "4.21.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "dotenv": "17.4.2",
    "fastify": "^5.2.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "redis": "^4.7.0"
  }
}
